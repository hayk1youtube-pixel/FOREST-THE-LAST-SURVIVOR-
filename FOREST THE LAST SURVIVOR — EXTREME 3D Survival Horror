      const arc = new THREE.Mesh(new THREE.TorusGeometry(0.34, 0.022, 6, 16, Math.PI), woodMat);
      arc.rotation.z = -Math.PI / 2;
      const str = new THREE.Mesh(new THREE.CylinderGeometry(0.004, 0.004, 0.68, 4), new THREE.MeshBasicMaterial({ color: 0xdddddd }));
      str.position.x = -0.02;
      viewmodel.add(arc, str);
    } else if (item && item.id === 'torch') {
      const stick = new THREE.Mesh(new THREE.CylinderGeometry(0.024, 0.024, 0.56, 8), woodMat);
      const wrap = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.032, 0.12, 8), new THREE.MeshStandardMaterial({ color: 0x222222 }));
      wrap.position.y = 0.24;
      const flame = new THREE.Mesh(new THREE.ConeGeometry(0.06, 0.16, 6), new THREE.MeshBasicMaterial({ color: 0xff8822 }));
      flame.position.y = 0.36;
      vmTorchLight = new THREE.PointLight(0xff8c33, 1.4, 16);
      vmTorchLight.position.set(0, 0.4, 0);
      viewmodel.add(stick, wrap, flame, vmTorchLight);
    }
    viewmodel.position.set(0.36, -0.32, -0.52);
  }

  const previewMat = new THREE.MeshBasicMaterial({ color: 0x4ea864, transparent: true, opacity: 0.45 });
  const buildPreview = new THREE.Mesh(new THREE.BoxGeometry(1.4, 0.8, 1.4), previewMat);
  buildPreview.visible = false;
  scene.add(buildPreview);

  function updatePreviewGeometry() {
    const def = BUILD_DEFS[state.buildType];
    buildPreview.geometry.dispose();
    buildPreview.geometry = new THREE.BoxGeometry(def.size[0], def.size[1], def.size[2]);
  }

  // =========================================================================
  // 9. WEATHER PARTICLES (RAIN)
  // =========================================================================
  const rainCount = 2200;
  const rainGeo = new THREE.BufferGeometry();
  const rainPositions = new Float32Array(rainCount * 3);
  for (let i = 0; i < rainCount; i++) {
    rainPositions[i*3] = (Math.random() - 0.5) * 65;
    rainPositions[i*3+1] = Math.random() * 30;
    rainPositions[i*3+2] = (Math.random() - 0.5) * 65;
  }
  rainGeo.setAttribute('position', new THREE.BufferAttribute(rainPositions, 3));
  const rainMat = new THREE.PointsMaterial({ color: 0xb8d4e3, size: 0.16, transparent: true, opacity: 0.6 });
  const rainPoints = new THREE.Points(rainGeo, rainMat);
  rainPoints.visible = false;
  scene.add(rainPoints);

  // =========================================================================
  // 10. PLAYER PHYSICS, CAMERA & CONTROLS
  // =========================================================================
  const player = {
    x: 2, y: 4, z: 2,
    vy: 0, yaw: 0, pitch: 0,
    onGround: false,
    stepTimer: 0
  };
  const keys = {};
  let isPointerLocked = false;
  let isDraggingLook = false;
  let lastMouseX = 0, lastMouseY = 0;

  document.addEventListener('pointerlockchange', () => {
    isPointerLocked = document.pointerLockElement === canvas;
    document.getElementById('click-to-lock').style.display =
      (state.mode === 'playing' && !isPointerLocked) ? 'block' : 'none';
  });

  canvas.addEventListener('click', () => {
    audio.init();
    if (state.mode === 'playing' && !isPointerLocked) {
      try { canvas.requestPointerLock(); } catch (e) {}
    }
  });

  document.getElementById('click-to-lock').addEventListener('click', () => {
    audio.init();
    try { canvas.requestPointerLock(); } catch (e) {}
  });

  document.addEventListener('mousemove', (e) => {
    if (state.mode !== 'playing') return;
    const sens = 0.0022 * state.settings.sensitivity;
    if (isPointerLocked) {
      player.yaw -= e.movementX * sens;
      player.pitch = Math.max(-Math.PI/2.1, Math.min(Math.PI/2.1, player.pitch - e.movementY * sens));
    } else if (isDraggingLook) {
      player.yaw -= (e.clientX - lastMouseX) * sens * 1.4;
      player.pitch = Math.max(-Math.PI/2.1, Math.min(Math.PI/2.1, player.pitch - (e.clientY - lastMouseY) * sens * 1.4));
    }
    lastMouseX = e.clientX;
    lastMouseY = e.clientY;
  });

  canvas.addEventListener('mousedown', (e) => {
    if (state.mode !== 'playing') return;
    if (e.button === 0) {
      if (state.buildMode) placeStructure();
      else performAttack();
    } else if (e.button === 2) {
      isDraggingLook = true;
      lastMouseX = e.clientX;
      lastMouseY = e.clientY;
    }
  });
  window.addEventListener('mouseup', () => { isDraggingLook = false; });
  canvas.addEventListener('contextmenu', (e) => e.preventDefault());

  window.addEventListener('keydown', (e) => {
    keys[e.code] = true;
    if (state.mode === 'playing') {
      if (e.code === 'Tab' || e.code === 'KeyI') { e.preventDefault(); openInventory(); }
      else if (e.code === 'KeyB') toggleBuildMode();
      else if (e.code === 'KeyR' && state.buildMode) state.buildRotation += Math.PI / 4;
      else if (e.code === 'KeyE') interact();
      else if (e.code === 'KeyF') toggleFlashlight();
      else if (e.code === 'KeyC' || e.code === 'ControlLeft') state.crouching = !state.crouching;
      else if (e.code === 'KeyP' || e.code === 'Escape') pauseGame();
      else if (['Digit1','Digit2','Digit3','Digit4','Digit5'].includes(e.code)) {
        selectHotbar(parseInt(e.code.replace('Digit', '')) - 1);
      }
    } else if (state.mode === 'inventory' && (e.code === 'Tab' || e.code === 'KeyI' || e.code === 'Escape')) {
      e.preventDefault(); closeInventory();
    } else if (state.mode === 'paused' && (e.code === 'KeyP' || e.code === 'Escape')) {
      resumeGame();
    }
  });

  window.addEventListener('keyup', (e) => { keys[e.code] = false; });

  // =========================================================================
  // 11. INVENTORY, CRAFTING & DRAG-AND-DROP
  // =========================================================================
  function addItem(itemId, qty = 1) {
    for (let i = 0; i < state.inventory.length; i++) {
      if (state.inventory[i] && state.inventory[i].id === itemId && ITEMS[itemId].type !== 'weapon') {
        state.inventory[i].qty += qty;
        renderHUD();
        return true;
      }
    }
    for (let i = 0; i < state.inventory.length; i++) {
      if (!state.inventory[i]) {
        state.inventory[i] = { id: itemId, qty };
        renderHUD();
        return true;
      }
    }
    showToast('Backpack is full!');
    return false;
  }

  function countItem(itemId) {
    let total = 0;
    for (const s of state.inventory) if (s && s.id === itemId) total += s.qty;
    return total;
  }

  function removeItem(itemId, qty) {
    let rem = qty;
    for (let i = 0; i < state.inventory.length && rem > 0; i++) {
      const s = state.inventory[i];
      if (s && s.id === itemId) {
        const take = Math.min(s.qty, rem);
        s.qty -= take;
        rem -= take;
        if (s.qty <= 0) state.inventory[i] = null;
      }
    }
    renderHUD();
  }

  function hasResources(req) {
    return Object.entries(req).every(([id, q]) => countItem(id) >= q);
  }

  function consumeResources(req) {
    Object.entries(req).forEach(([id, q]) => removeItem(id, q));
  }

  function getSelectedItem() {
    const slotIdx = state.hotbarIds[state.selectedHotbar];
    return state.inventory[slotIdx] || state.equipment.main;
  }

  function selectHotbar(idx) {
    state.selectedHotbar = idx;
    rebuildViewmodel();
    renderHUD();
  }

  function useOrEquipSlot(idx) {
    const slot = state.inventory[idx];
    if (!slot) return;
    const def = ITEMS[slot.id];
    if (def.type === 'food' || def.type === 'drink' || def.type === 'med') {
      if (def.hp) state.hp = Math.max(0, Math.min(100, state.hp + def.hp));
      if (def.hunger) state.hunger = Math.min(100, state.hunger + def.hunger);
      if (def.thirst) state.thirst = Math.min(100, state.thirst + def.thirst);
      removeItem(slot.id, 1);
      audio.playPickup();
      showToast(`Used ${def.name}`);
      if (state.mode === 'inventory') renderInventoryModal();
    } else if (def.type === 'weapon' || def.type === 'tool') {
      state.equipment.main = { ...slot };
      rebuildViewmodel();
      showToast(`Equipped ${def.name}`);
      if (state.mode === 'inventory') renderInventoryModal();
    }
  }

  let dragSourceIdx = null;
  function renderInventoryModal() {
    const eqEl = document.getElementById('equip-slots');
    eqEl.innerHTML = '';
    ['main', 'off', 'armor'].forEach((key) => {
      const item = state.equipment[key];
      const div = document.createElement('div');
      div.className = 'inv-slot';
      div.innerHTML = `<span class="slot-tag">${key.toUpperCase()}</span>` +
        (item ? `<span class="item-icon">${ITEMS[item.id].icon}</span><span class="item-name">${ITEMS[item.id].name}</span>` : `<span class="item-name" style="color:var(--text-muted)">Empty</span>`);
      div.addEventListener('dragover', (e) => { e.preventDefault(); div.classList.add('drag-over'); });
      div.addEventListener('dragleave', () => div.classList.remove('drag-over'));
      div.addEventListener('drop', (e) => {
        e.preventDefault(); div.classList.remove('drag-over');
        if (dragSourceIdx !== null && state.inventory[dragSourceIdx]) {
          state.equipment[key] = { ...state.inventory[dragSourceIdx] };
          rebuildViewmodel();
          renderInventoryModal();
          renderHUD();
        }
      });
      eqEl.appendChild(div);
    });

    const gridEl = document.getElementById('inv-grid');
    gridEl.innerHTML = '';
    state.inventory.forEach((slot, idx) => {
      const div = document.createElement('div');
      div.className = 'inv-slot';
      div.draggable = !!slot;
      if (slot) {
        const def = ITEMS[slot.id];
        div.innerHTML = `<span class="item-icon">${def.icon}</span><span class="item-name">${def.name}</span><span class="item-count">${slot.qty}</span>`;
        div.addEventListener('click', () => useOrEquipSlot(idx));
        div.addEventListener('dragstart', () => { dragSourceIdx = idx; });
      }
      div.addEventListener('dragover', (e) => { e.preventDefault(); div.classList.add('drag-over'); });
      div.addEventListener('dragleave', () => div.classList.remove('drag-over'));
      div.addEventListener('drop', (e) => {
        e.preventDefault(); div.classList.remove('drag-over');
        if (dragSourceIdx !== null && dragSourceIdx !== idx) {
          const tmp = state.inventory[idx];
          state.inventory[idx] = state.inventory[dragSourceIdx];
          state.inventory[dragSourceIdx] = tmp;
          dragSourceIdx = null;
          rebuildViewmodel();
          renderInventoryModal();
          renderHUD();
        }
      });
      gridEl.appendChild(div);
    });

    const craftEl = document.getElementById('craft-list');
    craftEl.innerHTML = '';
    RECIPES.forEach((r) => {
      const def = ITEMS[r.out];
      const can = hasResources(r.req);
      const reqStr = Object.entries(r.req).map(([k,v]) => `${v} ${ITEMS[k].name}`).join(', ');
      const row = document.createElement('div');
      row.className = 'craft-item';
      row.innerHTML = `<div class="craft-info"><h4>${def.icon} ${def.name} ${r.qty > 1 ? 'x'+r.qty : ''}</h4><p>${r.desc} • Needs: ${reqStr}</p></div>`;
      const btn = document.createElement('button');
      btn.className = 'craft-btn';
      btn.textContent = 'Craft';
      btn.disabled = !can;
      btn.addEventListener('click', () => {
        if (!hasResources(r.req)) return;
        consumeResources(r.req);
        addItem(r.out, r.qty);
        audio.playBuild();
        showToast(`Crafted ${def.name}`);
        renderInventoryModal();
      });
      row.appendChild(btn);
      craftEl.appendChild(row);
    });
  }

  // =========================================================================
  // 12. COMBAT, HARVESTING, BUILDING & INTERACTION
  // =========================================================================
  let attackCooldown = 0;

  function makeNoise(radius) {
    enemies.forEach((en) => {
      if (!en.alive) return;
      const d = Math.hypot(en.x - player.x, en.z - player.z);
      if (d < radius && en.state === 'PATROL') {
        en.state = 'INVESTIGATE';
        en.targetX = player.x;
        en.targetZ = player.z;
      }
    });
  }

  function spawnParticles(x, y, z, color, count = 8) {
    for (let i = 0; i < count; i++) {
      const m = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.1, 0.1), new THREE.MeshBasicMaterial({ color }));
      m.position.set(x, y, z);
      scene.add(m);
      particles.push({
        mesh: m,
        vx: (Math.random()-0.5)*5, vy: 2 + Math.random()*4, vz: (Math.random()-0.5)*5,
        life: 0.6
      });
    }
  }

  function performAttack() {
    if (attackCooldown > 0) return;
    const item = getSelectedItem();
    const def = item ? ITEMS[item.id] : { id: 'fist', damage: 10, range: 2.8, speed: 0.45 };
    attackCooldown = def.speed;
    vmSwing = 1.0;

    if (def.id === 'bow') {
      if (countItem('arrow') <= 0) { showToast('Out of Arrows! Craft more in Inventory.'); return; }
      removeItem('arrow', 1);
      audio.playBow();
      const dir = new THREE.Vector3(0, 0, -1).applyEuler(new THREE.Euler(player.pitch, player.yaw, 0, 'YXZ'));
      const arrowMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.03, 0.9, 5), woodMat);
      arrowMesh.rotation.x = Math.PI / 2;
      const g = new THREE.Group();
      g.add(arrowMesh);
      g.position.set(player.x, player.y + 1.5, player.z);
      g.lookAt(player.x + dir.x, player.y + 1.5 + dir.y, player.z + dir.z);
      scene.add(g);
      projectiles.push({ mesh: g, vx: dir.x * 38, vy: dir.y * 38, vz: dir.z * 38, life: 3.5, damage: def.damage });
      return;
    }

    const dir = new THREE.Vector3(0, 0, -1).applyEuler(new THREE.Euler(player.pitch, player.yaw, 0, 'YXZ'));
    let hitSomething = false;

    for (const en of enemies) {
      if (!en.alive) continue;
      const dx = en.x - player.x, dz = en.z - player.z;
      const dist = Math.hypot(dx, dz);
      if (dist < def.range) {
        const dot = (dx * dir.x + dz * dir.z) / (dist || 1);
        if (dot > 0.45) {
          en.hp -= def.damage;
          audio.playHit();
          spawnParticles(en.x, getTerrainHeight(en.x, en.z) + 1.2, en.z, 0xb91c1c, 10);
          en.state = 'CHASE';
          if (en.hp <= 0) {
            en.alive = false;
            scene.remove(en.mesh);
            state.kills++;
            showToast('Defeated forest cannibal!');
          }
          hitSomething = true;
          break;
        }
      }
    }
    if (hitSomething) return;

    for (const an of animals) {
      if (!an.alive) continue;
      const dx = an.x - player.x, dz = an.z - player.z;
      const dist = Math.hypot(dx, dz);
      if (dist < def.range) {
        an.hp -= def.damage;
        an.fleeing = true;
        audio.playHit();
        spawnParticles(an.x, getTerrainHeight(an.x, an.z) + 0.6, an.z, 0xb91c1c, 7);
        if (an.hp <= 0) {
          an.alive = false;
          scene.remove(an.mesh);
          addItem('raw_meat', an.type === 'deer' ? 2 : 1);
          addItem('hide', 1);
          showToast(`Hunted ${an.type}! (+Raw Meat, +Hide)`);
        }
        return;
      }
    }

    for (const h of harvestables) {
      if (!h.alive) continue;
      const dx = h.x - player.x, dz = h.z - player.z;
      const dist = Math.hypot(dx, dz);
      if (dist < 3.6) {
        const dot = (dx * dir.x + dz * dir.z) / (dist || 1);
        if (dot > 0.5) {
          h.hp--;
          if (h.type === 'tree') { audio.playChop(); makeNoise(28); spawnParticles(h.x, getTerrainHeight(h.x, h.z)+1.5, h.z, 0x6e4a2b, 6); }
          else if (h.type === 'rock') { audio.playMine(); makeNoise(24); spawnParticles(h.x, getTerrainHeight(h.x, h.z)+0.6, h.z, 0x9ca3af, 6); }
          else { audio.playPickup(); }

          if (h.hp <= 0) {
            h.alive = false;
            scene.remove(h.mesh);
            if (h.collider) {
              const idx = colliders.indexOf(h.collider);
              if (idx >= 0) colliders.splice(idx, 1);
            }
            if (h.type === 'tree') { addItem('wood', 3); addItem('leaf', 1); showToast('+3 Wood Log, +1 Leaves'); }
            else if (h.type === 'rock') { addItem('stone', 3); showToast('+3 Stone'); }
            else if (h.type === 'berry_bush') { addItem('leaf', 2); addItem('berries', 2); showToast('+2 Leaves, +2 Berries'); }
            else { addItem('leaf', 2); showToast('+2 Leaves'); }
          }
          return;
        }
      }
    }
  }

  function placeStructure() {
    const def = BUILD_DEFS[state.buildType];
    if (!hasResources(def.req)) {
      showToast(`Need: ${Object.entries(def.req).map(([k,v])=>`${v} ${ITEMS[k].name}`).join(', ')}`);
      return;
    }
    consumeResources(def.req);
    const x = buildPreview.position.x;
    const z = buildPreview.position.z;
    const y = getTerrainHeight(x, z);
    const g = new THREE.Group();
    let light = null;

    if (state.buildType === 'campfire') {
      for (let i = 0; i < 6; i++) {
        const st = new THREE.Mesh(new THREE.DodecahedronGeometry(0.22, 0), rockMat);
        const a = (i/6) * Math.PI * 2;
        st.position.set(Math.cos(a)*0.55, 0.15, Math.sin(a)*0.55);
        g.add(st);
      }
      const flame = new THREE.Mesh(new THREE.ConeGeometry(0.35, 0.75, 6), new THREE.MeshBasicMaterial({ color: 0xff6a1a }));
      flame.position.y = 0.45;
      g.add(flame);
      light = new THREE.PointLight(0xff7722, 2.5, 24);
      light.position.set(0, 1.1, 0);
      g.add(light);
      interactables.push({ mesh: g, type: 'campfire', x, z, label: 'Cook Raw Meat / Warm Up' });
    } else if (state.buildType === 'shelter') {
      const wallL = new THREE.Mesh(new THREE.BoxGeometry(0.3, 2.6, 4.0), woodMat); wallL.position.set(-1.9, 1.3, 0);
      const wallR = wallL.clone(); wallR.position.x = 1.9;
      const wallB = new THREE.Mesh(new THREE.BoxGeometry(4.0, 2.6, 0.3), woodMat); wallB.position.set(0, 1.3, -1.9);
      const roof = new THREE.Mesh(new THREE.ConeGeometry(3.2, 1.6, 4), bushMat); roof.position.set(0, 3.2, 0); roof.rotation.y = Math.PI/4;
      g.add(wallL, wallR, wallB, roof);
      interactables.push({ mesh: g, type: 'shelter', x, z, label: 'Sleep Until Dawn & Save' });
    } else if (state.buildType === 'wall') {
      const w = new THREE.Mesh(new THREE.BoxGeometry(4.0, 2.8, 0.45), woodMat);
      w.position.y = 1.4; w.castShadow = true;
      g.add(w);
      addCollider(x, z, 1.8);
    } else if (state.buildType === 'door') {
      const frameL = new THREE.Mesh(new THREE.BoxGeometry(1.1, 2.8, 0.45), woodMat); frameL.position.set(-1.45, 1.4, 0);
      const frameR = frameL.clone(); frameR.position.x = 1.45;
      const doorLeaf = new THREE.Mesh(new THREE.BoxGeometry(1.8, 2.6, 0.25), new THREE.MeshStandardMaterial({ map: woodPlankTex, color: 0x4d311a }));
      doorLeaf.position.set(0, 1.3, 0);
      g.add(frameL, frameR, doorLeaf);
      interactables.push({ mesh: doorLeaf, type: 'door', x, z, label: 'Open / Close Door', data: { open: false } });
    } else if (state.buildType === 'fence') {
      const f = new THREE.Mesh(new THREE.BoxGeometry(3.2, 1.1, 0.28), woodMat);
      f.position.y = 0.55; f.castShadow = true;
      g.add(f);
      addCollider(x, z, 1.3);
    } else if (state.buildType === 'trap') {
      const base = new THREE.Mesh(new THREE.BoxGeometry(1.8, 0.15, 1.8), woodMat);
      base.position.y = 0.08;
      g.add(base);
      for (let sx = -0.6; sx <= 0.6; sx += 0.6) {
        for (let sz = -0.6; sz <= 0.6; sz += 0.6) {
          const spike = new THREE.Mesh(new THREE.ConeGeometry(0.1, 0.7, 5), metalMat);
          spike.position.set(sx, 0.4, sz);
          g.add(spike);
        }
      }
    }

    g.position.set(x, y, z);
    g.rotation.y = state.buildRotation;
    scene.add(g);
    builtStructures.push({ mesh: g, type: state.buildType, x, z, light });
    state.structuresBuilt++;
    audio.playBuild();
    showToast(`Built ${def.name}!`);
    renderHUD();
  }

  function findNearbyInteraction() {
    for (let i = 0; i < pickups.length; i++) {
      const p = pickups[i];
      if (Math.hypot(p.x - player.x, p.z - player.z) < 3.0) {
        return { kind: 'pickup', idx: i, label: `Pick up ${ITEMS[p.itemId].name}` };
      }
    }
    for (let i = 0; i < interactables.length; i++) {
      const it = interactables[i];
      if (Math.hypot(it.x - player.x, it.z - player.z) < 3.6) {
        return { kind: 'interactable', idx: i, label: it.label, obj: it };
      }
    }
    if (player.y < WATER_LEVEL + 1.2) {
      return { kind: 'water', label: 'Drink Clean River/Lake Water' };
    }
    return null;
  }

  function interact() {
    const target = findNearbyInteraction();
    if (!target) return;
    if (target.kind === 'pickup') {
      const p = pickups[target.idx];
      if (addItem(p.itemId, p.qty)) {
        scene.remove(p.mesh);
        pickups.splice(target.idx, 1);
        audio.playPickup();
      }
    } else if (target.kind === 'water') {
      state.thirst = Math.min(100, state.thirst + 35);
      audio.playPickup();
      showToast('Drank clean water (+35 Thirst)');
    } else if (target.kind === 'interactable') {
      const it = target.obj;
      if (it.type === 'note') {
        if (!state.notesFound.includes(it.data.id)) state.notesFound.push(it.data.id);
        openNote(it.data.title, it.data.body);
      } else if (it.type === 'keycard') {
        state.hasKeycard = true;
        addItem('keycard', 1);
        scene.remove(it.mesh);
        interactables.splice(target.idx, 1);
        audio.playPickup();
        showToast('Obtained Lab Security Keycard!');
      } else if (it.type === 'campfire') {
        if (countItem('raw_meat') > 0) {
          removeItem('raw_meat', 1);
          addItem('cooked_meat', 1);
          audio.playPickup();
          showToast('Cooked Raw Meat into Cooked Meat!');
        } else {
          state.hp = Math.min(100, state.hp + 5);
          showToast('Warmed up by the campfire. Bring Raw Meat to cook.');
        }
      } else if (it.type === 'shelter') {
        state.day++;
        state.timeOfDay = 6.5;
        state.hp = Math.min(100, state.hp + 30);
        state.stamina = 100;
        saveGame();
        showToast(`Slept until Dawn — Day ${state.day}. Progress Saved.`);
      } else if (it.type === 'door') {
        it.data.open = !it.data.open;
        it.mesh.rotation.y = it.data.open ? Math.PI / 2 : 0;
        it.mesh.position.x = it.data.open ? 0.9 : 0;
        it.mesh.position.z = it.data.open ? 0.9 : 0;
        audio.playBuild();
      } else if (it.type === 'beacon') {
        if (state.hasKeycard) {
          state.beaconActivated = true;
          endGame(true);
        } else {
          showToast('Access Denied! Find the Lab Keycard in the Dark Cave (-48, 12).');
        }
      }
    }
  }

