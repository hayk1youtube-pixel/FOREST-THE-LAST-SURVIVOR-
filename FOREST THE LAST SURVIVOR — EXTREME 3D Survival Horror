      ctx.fillStyle = Math.random() < 0.5 ? 'rgba(35,38,40,0.45)' : 'rgba(130,136,142,0.35)';
      ctx.fillRect(Math.random()*s, Math.random()*s, 4 + Math.random()*16, 2 + Math.random()*8);
