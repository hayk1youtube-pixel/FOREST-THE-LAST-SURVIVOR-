    scene.add(g);
    harvestables.push({ mesh: g, type: hasBerries ? 'berry_bush' : 'bush', hp: 1, maxHp: 1, x, z, collider: null, alive: true });
  }

  function buildInstancedFlora(count) {
    if (grassInstanced) { scene.remove(grassInstanced); grassInstanced.dispose(); }
    if (flowerInstanced) { scene.remove(flowerInstanced); flowerInstanced.dispose(); }

    const bladeGeo = new THREE.ConeGeometry(0.11, 0.72, 3);
    bladeGeo.translate(0, 0.36, 0);
    const bladeMat = new THREE.MeshStandardMaterial({ color: 0x3b632c, roughness: 0.85 });
    grassInstanced = new THREE.InstancedMesh(bladeGeo, bladeMat, count);
    grassInstanced.receiveShadow = true;

    const flowerCount = Math.floor(count * 0.12);
    const flowerGeo = new THREE.DodecahedronGeometry(0.12, 0);
    const flowerMat = new THREE.MeshStandardMaterial({ color: 0xe8c55a, roughness: 0.6 });
    flowerInstanced = new THREE.InstancedMesh(flowerGeo, flowerMat, flowerCount);

    const dummy = new THREE.Object3D();
    let gi = 0, fi = 0;
    for (let i = 0; i < count * 1.4 && gi < count; i++) {
      const x = (Math.random() - 0.5) * 180;
      const z = (Math.random() - 0.5) * 180;
      const y = getTerrainHeight(x, z);
      if (y < WATER_LEVEL + 0.15 || y > 8.5) continue;

      dummy.position.set(x, y, z);
      dummy.rotation.set((Math.random()-0.5)*0.2, Math.random()*Math.PI*2, (Math.random()-0.5)*0.2);
      const sc = 0.65 + Math.random() * 0.9;
      dummy.scale.set(sc, sc, sc);
      dummy.updateMatrix();
      grassInstanced.setMatrixAt(gi++, dummy.matrix);

      if (fi < flowerCount && Math.random() < 0.25) {
        dummy.position.set(x + 0.2, y + 0.25, z + 0.2);
        dummy.scale.set(0.8, 0.8, 0.8);
        dummy.updateMatrix();
        flowerInstanced.setMatrixAt(fi++, dummy.matrix);
      }
    }
    grassInstanced.count = gi;
    flowerInstanced.count = fi;
    grassInstanced.instanceMatrix.needsUpdate = true;
    flowerInstanced.instanceMatrix.needsUpdate = true;
    scene.add(grassInstanced, flowerInstanced);
  }

  function spawnPickup(itemId, qty, x, z) {
