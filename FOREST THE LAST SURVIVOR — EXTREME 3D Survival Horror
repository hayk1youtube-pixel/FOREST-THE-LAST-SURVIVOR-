  let lastTime = performance.now();
  let hudTick = 0;
  let nightSpawnDone = false;

  function triggerLightning() {
    const lf = document.getElementById('lightning-flash');
    lf.style.opacity = '1';
    sunLight.intensity = 3.5;
    setTimeout(() => { lf.style.opacity = '0'; }, 90);
    setTimeout(() => { lf.style.opacity = '0.7'; setTimeout(() => { lf.style.opacity = '0'; }, 70); }, 180);
    audio.playThunder();
  }

  function updateDayNightAndWeather(dt) {
    state.timeOfDay += dt / 18;
    if (state.timeOfDay >= 24) {
      state.timeOfDay -= 24;
      state.day++;
      nightSpawnDone = false;
      showToast(`Day ${state.day} Survived`);
    }

    const isNight = state.timeOfDay < 5.5 || state.timeOfDay > 19.5;
    if (isNight && !nightSpawnDone) {
      nightSpawnDone = true;
      const ang = Math.random() * Math.PI * 2;
      spawnEnemy('stalker', player.x + Math.cos(ang)*32, player.z + Math.sin(ang)*32);
      showToast('Night falls... Night Stalkers are hunting.');
    }

    const sunAngle = ((state.timeOfDay - 6) / 24) * Math.PI * 2;
    const sx = Math.cos(sunAngle) * 140;
    const sy = Math.sin(sunAngle) * 140;
    sunLight.position.set(sx * 0.6, sy * 0.6, 35);
    sunDisc.position.set(sx, sy, 35);
    moonDisc.position.set(-sx, -sy, -35);
    moonLight.position.set(-sx * 0.5, -sy * 0.5, -35);

    const dayFactor = Math.max(0, Math.sin(sunAngle));
    const goldenHour = Math.max(0, 1 - Math.abs(dayFactor - 0.18) * 4.5);

    sunLight.intensity = 0.06 + dayFactor * 1.25;
    sunLight.color.setRGB(1.0, 0.85 + dayFactor * 0.13 - goldenHour * 0.25, 0.7 + dayFactor * 0.25 - goldenHour * 0.45);
    moonLight.intensity = isNight ? 0.35 : 0.0;
    hemiLight.intensity = 0.12 + dayFactor * 0.65;
    starMat.opacity = isNight ? 0.85 : 0.0;

    // God rays intensity
    const preset = GRAPHICS_PRESETS[state.settings.graphics] || GRAPHICS_PRESETS.high;
    godRaysGroup.visible = preset.rays && dayFactor > 0.08 && !isNight;
    rayMat.opacity = (0.04 + goldenHour * 0.06) * dayFactor;

    // Weather transitions & Wetness
    state.weatherTimer -= dt;
    if (state.weatherTimer <= 0) {
      const r = Math.random();
      state.weather = r < 0.48 ? 'Clear' : (r < 0.78 ? 'Misty Fog' : 'Rainstorm');
      state.weatherTimer = 45 + Math.random() * 45;
      if (state.weather === 'Rainstorm') triggerLightning();
    }

    const isRaining = state.weather === 'Rainstorm';
    if (isRaining) {
      state.wetness = Math.min(1.0, state.wetness + dt * 0.15);
      state.lightningTimer -= dt;
      if (state.lightningTimer <= 0) {
        triggerLightning();
        state.lightningTimer = 10 + Math.random() * 14;
      }
    } else {
      state.wetness = Math.max(0.0, state.wetness - dt * 0.04);
    }

    // Wet PBR Surface Modulation
    terrainMat.roughness = 0.92 - state.wetness * 0.52;
    rockMat.roughness = 0.88 - state.wetness * 0.55;
    barkMat.roughness = 0.94 - state.wetness * 0.45;
    woodMat.roughness = 0.86 - state.wetness * 0.48;

    rainPoints.visible = isRaining;
    if (isRaining) {
      rainPoints.position.set(player.x, player.y, player.z);
      const rp = rainGeo.attributes.position.array;
      for (let i = 0; i < rainCount; i++) {
        rp[i*3+1] -= 26 * dt;
        if (rp[i*3+1] < -2) rp[i*3+1] = 28;
      }
      rainGeo.attributes.position.needsUpdate = true;
    }

    const inCave = Math.hypot(player.x + 48, player.z - 2) < 15;
    const targetSky = inCave ? new THREE.Color(0x040507) :
      (isNight ? new THREE.Color(0x05080d) :
      (isRaining ? new THREE.Color(0x36444c) :
      (goldenHour > 0.3 ? new THREE.Color(0xb87654) : new THREE.Color(0x6d8c99))));
    scene.background.lerp(targetSky, 0.04);
    scene.fog.color.copy(scene.background);
    const targetFog = inCave ? 0.06 : (state.weather === 'Misty Fog' ? 0.032 : (isNight ? 0.026 : 0.011));
    scene.fog.density += (targetFog - scene.fog.density) * 0.04;

    return { isNight, isRaining, inCave };
  }

  function updatePlayer(dt) {
    if (attackCooldown > 0) attackCooldown -= dt;

    let moveX = 0, moveZ = 0;
    if (keys['KeyW']) moveZ -= 1;
    if (keys['KeyS']) moveZ += 1;
    if (keys['KeyA']) moveX -= 1;
    if (keys['KeyD']) moveX += 1;

    const moving = moveX !== 0 || moveZ !== 0;
    const sprinting = moving && (keys['ShiftLeft'] || keys['ShiftRight']) && !state.crouching && state.stamina > 5;
    if (sprinting) state.stamina = Math.max(0, state.stamina - 16 * dt);
    else state.stamina = Math.min(100, state.stamina + 11 * dt);

    const speed = state.crouching ? 3.2 : (sprinting ? 8.8 : 5.4);
    if (moving) {
      const len = Math.hypot(moveX, moveZ);
      moveX /= len; moveZ /= len;
      const sin = Math.sin(player.yaw), cos = Math.cos(player.yaw);
      const wx = (moveX * cos + moveZ * sin) * speed * dt;
      const wz = (-moveX * sin + moveZ * cos) * speed * dt;

      let nx = Math.max(-HALF_WORLD + 8, Math.min(HALF_WORLD - 8, player.x + wx));
      let nz = Math.max(-HALF_WORLD + 8, Math.min(HALF_WORLD - 8, player.z + wz));

      for (const c of colliders) {
        const dx = nx - c.x, dz = nz - c.z;
        const d = Math.hypot(dx, dz);
        if (d < c.r + 0.45) {
          const push = (c.r + 0.45 - d) / (d || 1);
          nx += dx * push;
          nz += dz * push;
        }
      }
      player.x = nx; player.z = nz;

      player.stepTimer -= dt * (sprinting ? 1.6 : 1.0);
      if (player.stepTimer <= 0) {
        audio.playFootstep(sprinting);
        player.stepTimer = 0.42;
        if (sprinting) makeNoise(16);
      }
    }

    if (keys['Space'] && player.onGround) {
      player.vy = 7.5;
      player.onGround = false;
    }
    player.vy -= 19.6 * dt;
    player.y += player.vy * dt;

    const groundY = getTerrainHeight(player.x, player.z);
    if (player.y <= groundY) {
      player.y = groundY;
      player.vy = 0;
      player.onGround = true;
    }

    const eyeHeight = state.crouching ? 1.05 : 1.72;
    const bob = moving ? Math.sin(performance.now() * (sprinting ? 0.015 : 0.01)) * 0.055 : 0;
    playerGroup.position.set(player.x, player.y + eyeHeight + bob, player.z);
    camera.rotation.order = 'YXZ';
    camera.rotation.y = player.yaw;
    camera.rotation.x = player.pitch;

    if (vmSwing > 0) vmSwing = Math.max(0, vmSwing - dt * 4.5);
    viewmodel.rotation.x = -vmSwing * 1.1;
    viewmodel.position.y = -0.32 + Math.sin(performance.now() * 0.003) * 0.012 + (moving ? Math.abs(bob)*0.4 : 0);
    if (vmTorchLight) vmTorchLight.intensity = 1.2 + Math.sin(performance.now() * 0.02) * 0.3;

    if (state.buildMode) {
      const fx = player.x - Math.sin(player.yaw) * 4.2;
      const fz = player.z - Math.cos(player.yaw) * 4.2;
      buildPreview.position.set(fx, getTerrainHeight(fx, fz) + BUILD_DEFS[state.buildType].size[1]/2, fz);
      buildPreview.rotation.y = state.buildRotation;
      previewMat.color.setHex(hasResources(BUILD_DEFS[state.buildType].req) ? 0x4ea864 : 0xd63c3c);
    }

    state.hunger = Math.max(0, state.hunger - 0.38 * dt);
    state.thirst = Math.max(0, state.thirst - 0.52 * dt);
    if (state.hunger <= 0 || state.thirst <= 0) state.hp -= 2.5 * dt;
    if (state.hp <= 0) { state.hp = 0; endGame(false); }
  }

  function updateEntities(dt, isNight) {
    for (const an of animals) {
      if (!an.alive) continue;
      const distP = Math.hypot(an.x - player.x, an.z - player.z);
      if (distP < 11) an.fleeing = true;
      else if (distP > 24) an.fleeing = false;

      an.timer -= dt;
      if (an.fleeing) an.dir = Math.atan2(an.x - player.x, an.z - player.z);
      else if (an.timer <= 0) { an.dir = Math.random() * Math.PI * 2; an.timer = 2 + Math.random() * 4; }
      const spd = an.fleeing ? 6.5 : 1.5;
      an.x = Math.max(-95, Math.min(95, an.x + Math.sin(an.dir) * spd * dt));
      an.z = Math.max(-95, Math.min(95, an.z + Math.cos(an.dir) * spd * dt));
      an.mesh.position.set(an.x, getTerrainHeight(an.x, an.z), an.z);
      an.mesh.rotation.y = an.dir;
    }

    let nearDanger = false;
    for (const en of enemies) {
      if (!en.alive) continue;
      const dx = player.x - en.x, dz = player.z - en.z;
      const dist = Math.hypot(dx, dz);
      if (dist < 22) nearDanger = true;

      const detectRange = (isNight ? 24 : 17) * (state.crouching ? 0.55 : 1.0);
      if (dist < detectRange) en.state = 'CHASE';
      else if (en.state === 'CHASE' && dist > 32) en.state = 'PATROL';

      en.soundTimer -= dt;
      if (en.soundTimer <= 0 && dist < 28) { audio.playCannibal(); en.soundTimer = 5 + Math.random() * 6; }
      if (en.attackCd > 0) en.attackCd -= dt;

      for (const st of builtStructures) {
        if (st.type === 'trap' && Math.hypot(en.x - st.x, en.z - st.z) < 1.5) {
          en.hp -= 22 * dt;
          if (en.hp <= 0 && en.alive) {
            en.alive = false; scene.remove(en.mesh); state.kills++;
            showToast('Spike Trap killed a cannibal!');
          }
        }
      }
      if (!en.alive) continue;

      if (en.state === 'CHASE') {
        const ang = Math.atan2(dx, dz);
        const mult = isNight ? 1.15 : 1.0;
        if (dist > 1.8) {
          en.x += Math.sin(ang) * en.speed * mult * dt;
          en.z += Math.cos(ang) * en.speed * mult * dt;
          en.mesh.rotation.y = ang;
        } else if (en.attackCd <= 0) {
          en.attackCd = 1.3;
          state.hp = Math.max(0, state.hp - en.damage);
          audio.playHurt();
          const df = document.getElementById('damage-flash');
          df.style.opacity = '1';
          setTimeout(() => { df.style.opacity = '0'; }, 180);
        }
      } else if (en.state === 'INVESTIGATE') {
        const tx = en.targetX - en.x, tz = en.targetZ - en.z;
        const td = Math.hypot(tx, tz);
        if (td > 2) {
          const ang = Math.atan2(tx, tz);
          en.x += Math.sin(ang) * (en.speed * 0.75) * dt;
          en.z += Math.cos(ang) * (en.speed * 0.75) * dt;
          en.mesh.rotation.y = ang;
        } else en.state = 'PATROL';
      } else {
        const tx = en.targetX - en.x, tz = en.targetZ - en.z;
        if (Math.hypot(tx, tz) < 2) {
          en.targetX = Math.max(-90, Math.min(90, en.x + (Math.random()-0.5)*35));
          en.targetZ = Math.max(-90, Math.min(90, en.z + (Math.random()-0.5)*35));
        } else {
          const ang = Math.atan2(tx, tz);
          en.x += Math.sin(ang) * (en.speed * 0.45) * dt;
          en.z += Math.cos(ang) * (en.speed * 0.45) * dt;
          en.mesh.rotation.y = ang;
        }
      }
      en.mesh.position.set(en.x, getTerrainHeight(en.x, en.z), en.z);
    }

    for (let i = projectiles.length - 1; i >= 0; i--) {
      const pr = projectiles[i];
      pr.vy -= 9.8 * dt;
      pr.mesh.position.x += pr.vx * dt;
      pr.mesh.position.y += pr.vy * dt;
      pr.mesh.position.z += pr.vz * dt;
      pr.life -= dt;

      let hit = false;
      for (const en of enemies) {
        if (!en.alive) continue;
        if (Math.hypot(pr.mesh.position.x - en.x, pr.mesh.position.z - en.z) < 0.9 &&
            Math.abs(pr.mesh.position.y - (getTerrainHeight(en.x, en.z) + 1.1)) < 1.3) {
          en.hp -= pr.damage; en.state = 'CHASE'; audio.playHit();
          spawnParticles(en.x, pr.mesh.position.y, en.z, 0xb91c1c, 9);
          if (en.hp <= 0) { en.alive = false; scene.remove(en.mesh); state.kills++; showToast('Arrow kill!'); }
          hit = true; break;
        }
      }
      if (!hit) {
        for (const an of animals) {
          if (!an.alive) continue;
          if (Math.hypot(pr.mesh.position.x - an.x, pr.mesh.position.z - an.z) < 0.9) {
            an.hp -= pr.damage; audio.playHit();
            if (an.hp <= 0) {
              an.alive = false; scene.remove(an.mesh);
              addItem('raw_meat', an.type === 'deer' ? 2 : 1); addItem('hide', 1);
              showToast(`Hunted ${an.type} with Bow!`);
            }
            hit = true; break;
          }
        }
      }

      if (hit || pr.life <= 0 || pr.mesh.position.y < getTerrainHeight(pr.mesh.position.x, pr.mesh.position.z)) {
        scene.remove(pr.mesh); projectiles.splice(i, 1);
      }
    }

    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      p.vy -= 14 * dt;
      p.mesh.position.x += p.vx * dt;
      p.mesh.position.y += p.vy * dt;
      p.mesh.position.z += p.vz * dt;
      p.life -= dt;
      if (p.life <= 0) { scene.remove(p.mesh); particles.splice(i, 1); }
    }

    return nearDanger;
  }

  function animate(now) {
    requestAnimationFrame(animate);
    const dt = Math.min(0.05, (now - lastTime) / 1000);
    lastTime = now;

    // Animated Water & Mist
    waterNormalTex.offset.x += dt * 0.04;
    waterNormalTex.offset.y += dt * 0.025;
    waterfallMat.opacity = 0.65 + Math.sin(now * 0.009) * 0.14;
    mistPlanes.forEach(m => {
      m.mesh.position.x += m.speed * dt;
      if (m.mesh.position.x > 95) m.mesh.position.x = -95;
    });

    if (state.mode === 'menu') {
      const t = now * 0.00018;
      playerGroup.position.set(Math.cos(t) * 28, 12, Math.sin(t) * 28);
      camera.rotation.set(-0.22, -t + Math.PI / 2, 0);
      renderer.render(scene, camera);
      return;
    }

    if (state.mode === 'playing') {
      const env = updateDayNightAndWeather(dt);
      updatePlayer(dt);
      const nearDanger = updateEntities(dt, env.isNight);
      audio.updateAmbience(env.isNight, env.isRaining, nearDanger, env.inCave);

      if (!env.isNight && !env.isRaining && Math.random() < 0.004) audio.playBird();

      builtStructures.forEach(s => {
        if (s.light) s.light.intensity = 2.0 + Math.sin(now * 0.016 + s.x) * 0.45;
      });

      const inter = findNearbyInteraction();
      const promptEl = document.getElementById('interact-prompt');
      const chEl = document.getElementById('crosshair');
      if (inter) {
        promptEl.innerHTML = `<span class="key">E</span>${inter.label}`;
        promptEl.style.display = 'block';
        chEl.classList.add('active');
      } else {
        promptEl.style.display = 'none';
        chEl.classList.remove('active');
      }

      hudTick += dt;
      if (hudTick > 0.2) { hudTick = 0; renderHUD(); }
    }

    renderer.render(scene, camera);
  }

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });

  window.onload = () => {
    populateWorld();
    populateLife();
    checkSaveExists();
    requestAnimationFrame(animate);
  };
})();
</script>
</body>
</html>
