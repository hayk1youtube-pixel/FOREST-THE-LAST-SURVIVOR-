  // Heightmap Function
  function getTerrainHeight(x, z) {
    let h = Math.sin(x * 0.04) * Math.cos(z * 0.04) * 2.8 +
            Math.sin(x * 0.11 + 1.3) * Math.sin(z * 0.09) * 1.1 +
            Math.sin(x * 0.25) * Math.cos(z * 0.25) * 0.25;

    const riverX = Math.sin(z * 0.045) * 18 - 10;
    const distRiver = Math.abs(x - riverX);
    if (distRiver < 9) {
      const t = 1 - distRiver / 9;
      h -= t * t * 3.2;
    }

    const distLake = Math.hypot(x - 30, z - 35);
    if (distLake < 22) {
      const t = 1 - distLake / 22;
      h -= t * t * 4.0;
    }

    const edgeDist = Math.max(Math.abs(x), Math.abs(z));
    if (edgeDist > 85) h += Math.pow((edgeDist - 85) / 14, 1.8) * 6.5;
    if (z < -45 && Math.abs(x + 10) < 28) h += Math.min(14, (-45 - z) * 0.55);

    const distCrash = Math.hypot(x, z);
    if (distCrash < 14) h = h * (distCrash / 14) + 1.2 * (1 - distCrash / 14);
    return h;
  }

