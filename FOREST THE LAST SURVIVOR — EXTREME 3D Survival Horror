  };

  // =========================================================================
  // 2. PROCEDURAL WEB AUDIO ENGINE
  // =========================================================================
  class SoundEngine {
    constructor() {
      this.ctx = null;
      this.masterGain = null;
      this.ambGain = null;
      this.sfxGain = null;
      this.muted = false;
      this.masterVol = 0.7;
      this.ambVol = 0.6;
      this.windNode = null;
      this.rainGain = null;
      this.droneOsc = null;
      this.droneGain = null;
      this.initialized = false;
    }

    init() {
      if (this.initialized) {
        if (this.ctx && this.ctx.state === 'suspended') this.ctx.resume();
        return;
      }
      const AudioCtx = window.AudioContext || window.webkitAudioContext;
      if (!AudioCtx) return;
      this.ctx = new AudioCtx();
      this.masterGain = this.ctx.createGain();
      this.ambGain = this.ctx.createGain();
      this.sfxGain = this.ctx.createGain();

      this.ambGain.connect(this.masterGain);
      this.sfxGain.connect(this.masterGain);
      this.masterGain.connect(this.ctx.destination);

      this.applyVolumes();
      this.startAmbience();
      this.initialized = true;
    }

    applyVolumes() {
      if (!this.ctx) return;
      const m = this.muted ? 0 : this.masterVol;
      this.masterGain.gain.setTargetAtTime(m, this.ctx.currentTime, 0.05);
      this.ambGain.gain.setTargetAtTime(this.ambVol, this.ctx.currentTime, 0.05);
      this.sfxGain.gain.setTargetAtTime(1.0, this.ctx.currentTime, 0.05);
    }

    createNoiseBuffer(seconds = 2) {
      const rate = this.ctx.sampleRate;
      const buf = this.ctx.createBuffer(1, rate * seconds, rate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;
      return buf;
    }

    startAmbience() {
      const noiseBuf = this.createNoiseBuffer(3);

      const windSrc = this.ctx.createBufferSource();
      windSrc.buffer = noiseBuf;
      windSrc.loop = true;
      const windFilter = this.ctx.createBiquadFilter();
      windFilter.type = 'bandpass';
      windFilter.frequency.value = 340;
      windFilter.Q.value = 1.4;
      const windGain = this.ctx.createGain();
      windGain.gain.value = 0.08;
      windSrc.connect(windFilter).connect(windGain).connect(this.ambGain);
      windSrc.start();
      this.windNode = windGain;

      const rainSrc = this.ctx.createBufferSource();
      rainSrc.buffer = noiseBuf;
      rainSrc.loop = true;
      const rainFilter = this.ctx.createBiquadFilter();
      rainFilter.type = 'lowpass';
      rainFilter.frequency.value = 1800;
      this.rainGain = this.ctx.createGain();
      this.rainGain.gain.value = 0.0;
      rainSrc.connect(rainFilter).connect(this.rainGain).connect(this.ambGain);
      rainSrc.start();

      this.droneOsc = this.ctx.createOscillator();
      this.droneOsc.type = 'sawtooth';
      this.droneOsc.frequency.value = 52;
      const droneFilter = this.ctx.createBiquadFilter();
      droneFilter.type = 'lowpass';
      droneFilter.frequency.value = 140;
      this.droneGain = this.ctx.createGain();
      this.droneGain.gain.value = 0.0;
      this.droneOsc.connect(droneFilter).connect(this.droneGain).connect(this.ambGain);
      this.droneOsc.start();
    }

    updateAmbience(isNight, isRaining, nearDanger, inCave) {
      if (!this.initialized || !this.ctx) return;
      const t = this.ctx.currentTime;
      this.rainGain.gain.setTargetAtTime(isRaining ? 0.22 : 0.0, t, 0.8);
      const tension = (isNight ? 0.05 : 0.01) + (nearDanger ? 0.09 : 0) + (inCave ? 0.06 : 0);
      this.droneGain.gain.setTargetAtTime(tension, t, 0.4);
      this.windNode.gain.setTargetAtTime(inCave ? 0.02 : (isRaining ? 0.14 : 0.07), t, 0.5);
    }

    playTone(freq, dur, type = 'sine', vol = 0.2, slideTo = null) {
      if (!this.initialized || !this.ctx || this.muted) return;
      const t = this.ctx.currentTime;
      const osc = this.ctx.createOscillator();
      const g = this.ctx.createGain();
      osc.type = type;
      osc.frequency.setValueAtTime(freq, t);
      if (slideTo) osc.frequency.exponentialRampToValueAtTime(Math.max(20, slideTo), t + dur);
      g.gain.setValueAtTime(vol, t);
      g.gain.exponentialRampToValueAtTime(0.001, t + dur);
      osc.connect(g).connect(this.sfxGain);
      osc.start(t);
      osc.stop(t + dur);
    }

    playNoiseBurst(dur = 0.12, freq = 800, vol = 0.25) {
      if (!this.initialized || !this.ctx || this.muted) return;
      const t = this.ctx.currentTime;
      const src = this.ctx.createBufferSource();
      src.buffer = this.createNoiseBuffer(0.5);
      const f = this.ctx.createBiquadFilter();
      f.type = 'lowpass';
      f.frequency.value = freq;
      const g = this.ctx.createGain();
      g.gain.setValueAtTime(vol, t);
      g.gain.exponentialRampToValueAtTime(0.001, t + dur);
      src.connect(f).connect(g).connect(this.sfxGain);
      src.start(t);
      src.stop(t + dur);
    }

    playFootstep(sprinting) { this.playNoiseBurst(0.08, sprinting ? 550 : 380, sprinting ? 0.18 : 0.1); }
    playChop() { this.playTone(130, 0.12, 'triangle', 0.3, 55); this.playNoiseBurst(0.09, 1200, 0.22); }
    playMine() { this.playTone(520, 0.09, 'square', 0.15, 220); this.playNoiseBurst(0.07, 2400, 0.18); }
    playBow() { this.playTone(260, 0.18, 'triangle', 0.22, 95); }
    playHit() { this.playTone(110, 0.14, 'sawtooth', 0.28, 45); this.playNoiseBurst(0.1, 700, 0.22); }
    playPickup() { this.playTone(540, 0.1, 'sine', 0.14, 780); }
    playBuild() { this.playTone(180, 0.16, 'triangle', 0.25, 110); this.playNoiseBurst(0.12, 900, 0.2); }
    playThunder() { this.playNoiseBurst(1.6, 180, 0.45); this.playTone(65, 1.2, 'sawtooth', 0.18, 30); }
    playCannibal() { this.playTone(210 + Math.random()*80, 0.45, 'sawtooth', 0.2, 90); }
    playBird() { this.playTone(1900 + Math.random()*500, 0.12, 'sine', 0.05, 2400); }
    playHurt() { this.playTone(150, 0.25, 'sawtooth', 0.35, 55); }
  }

  const audio = new SoundEngine();

  // =========================================================================
  // 3. GAME STATE & GRAPHICS PRESETS
  // =========================================================================
