  function updateMissionText() {
    let text = '';
    const hasCampfire = builtStructures.some(s => s.type === 'campfire');
    const hasShelter = builtStructures.some(s => s.type === 'shelter');
    if (!hasCampfire) text = 'Gather 3 Wood & 3 Stones, then press [B] to build a Campfire.';
    else if (!hasShelter) text = 'Hunt animals for food and build a Wooden Shelter [B] before nightfall.';
    else if (!state.hasKeycard) text = `Explore the Dark Cave (West) for the Lab Keycard. Notes: ${state.notesFound.length}/3.`;
    else if (!state.beaconActivated) text = `Reach the Abandoned Lab (Northeast) and activate the Rescue Beacon! Notes: ${state.notesFound.length}/3.`;
