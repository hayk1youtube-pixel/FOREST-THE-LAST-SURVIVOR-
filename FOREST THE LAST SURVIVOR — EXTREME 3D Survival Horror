  scene.add(godRaysGroup);

  // Drifting Ground Mist Planes
  const mistPlanes = [];
  const mistMat = new THREE.MeshBasicMaterial({ color: 0xbacbd1, transparent: true, opacity: 0.075, depthWrite: false, side: THREE.DoubleSide });
