  }, 2, 2);

  const waterNormalTex = makeProceduralTexture(256, (ctx, s) => {
    ctx.fillStyle = 'rgb(128,128,255)';
    ctx.fillRect(0, 0, s, s);
    for (let i = 0; i < 240; i++) {
      const x = Math.random()*s, y = Math.random()*s;
