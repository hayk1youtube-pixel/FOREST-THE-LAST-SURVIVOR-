  sunLight.shadow.mapSize.height = 2048;
  sunLight.shadow.camera.near = 10;
  sunLight.shadow.camera.far = 220;
  sunLight.shadow.bias = -0.0005;
  const d = 75;
  sunLight.shadow.camera.left = -d;
  sunLight.shadow.camera.right = d;
  sunLight.shadow.camera.top = d;
  sunLight.shadow.camera.bottom = -d;
  scene.add(sunLight);

  const moonLight = new THREE.DirectionalLight(0x6b88b5, 0.0);
  moonLight.position.set(-50, 70, -40);
  scene.add(moonLight);

  // Realistic Flashlight + Subtle Rim Fill
  const playerLight = new THREE.SpotLight(0xffe8bd, 0, 48, Math.PI / 4.5, 0.5, 1.2);
  playerLight.position.set(0.15, -0.1, 0);
  playerLight.target.position.set(0, -0.1, -1);
  camera.add(playerLight);
  camera.add(playerLight.target);

  // Volumetric God Rays Group
  const godRaysGroup = new THREE.Group();
  const rayMat = new THREE.MeshBasicMaterial({
    color: 0xffe8b0, transparent: true, opacity: 0.06,
    blending: THREE.AdditiveBlending, depthWrite: false, side: THREE.DoubleSide
  });
  for (let i = 0; i < 14; i++) {
    const ray = new THREE.Mesh(new THREE.ConeGeometry(4.5 + Math.random()*3, 38, 12, 1, true), rayMat);
    ray.position.set((Math.random()-0.5)*110, 16, (Math.random()-0.5)*110);
