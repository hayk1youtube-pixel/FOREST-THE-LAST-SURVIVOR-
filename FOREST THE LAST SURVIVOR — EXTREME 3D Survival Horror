
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>FOREST: THE LAST SURVIVOR — EXTREME 3D Survival Horror</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;900&family=Inter:wght@400;500;600;700&display=swap');

    :root {
      --bg-dark: #060908;
      --panel-bg: rgba(10, 15, 13, 0.88);
      --panel-border: rgba(125, 150, 135, 0.28);
      --accent: #c83e2b;
      --accent-glow: rgba(200, 62, 43, 0.48);
      --gold: #d4a656;
      --green: #4ea864;
      --blue: #3b8fc2;
      --amber: #d98a36;
      --text-main: #e6ece8;
      --text-muted: #8b9a91;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; -webkit-user-select: none; }
    html, body { width: 100%; height: 100%; overflow: hidden; background: var(--bg-dark); color: var(--text-main); font-family: 'Inter', sans-serif; }

    #game-canvas { position: fixed; inset: 0; width: 100%; height: 100%; display: block; z-index: 1; }

    /* Vignette, Color Grading & Damage / Lightning Overlays */
    #vignette {
      position: fixed; inset: 0; pointer-events: none; z-index: 3;
      background: radial-gradient(circle at center, transparent 48%, rgba(0,0,0,0.78) 100%);
      transition: background 0.3s ease;
    }
    #damage-flash {
      position: fixed; inset: 0; pointer-events: none; z-index: 4; opacity: 0;
      background: radial-gradient(circle at center, rgba(180,20,20,0.18) 35%, rgba(160,10,10,0.8) 100%);
      transition: opacity 0.15s ease;
    }
    #lightning-flash {
      position: fixed; inset: 0; pointer-events: none; z-index: 4; opacity: 0;
      background: rgba(220, 235, 255, 0.55);
      transition: opacity 0.08s ease;
    }

    /* Crosshair & Interaction Prompt */
    #crosshair {
      position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
      width: 10px; height: 10px; border-radius: 50%;
      border: 2px solid rgba(255,255,255,0.78);
      box-shadow: 0 0 8px rgba(0,0,0,0.85);
      pointer-events: none; z-index: 10; display: none;
      transition: transform 0.12s ease, border-color 0.12s ease;
    }
    #crosshair.active { transform: translate(-50%, -50%) scale(1.45); border-color: var(--gold); }

    #interact-prompt {
      position: fixed; top: 56%; left: 50%; transform: translateX(-50%);
      background: rgba(10, 14, 12, 0.88); border: 1px solid var(--panel-border);
      padding: 8px 16px; border-radius: 6px; font-size: 13px; font-weight: 500;
      letter-spacing: 0.4px; pointer-events: none; z-index: 11; display: none;
      backdrop-filter: blur(8px); box-shadow: 0 4px 18px rgba(0,0,0,0.55);
    }
    #interact-prompt span.key {
      display: inline-block; background: var(--gold); color: #111; font-weight: 700;
      padding: 1px 6px; border-radius: 4px; margin-right: 6px; font-size: 12px;
    }

    /* HUD */
    #hud { position: fixed; inset: 0; pointer-events: none; z-index: 10; display: none; }

    .hud-top-left {
      position: absolute; top: 16px; left: 16px;
      background: var(--panel-bg); border: 1px solid var(--panel-border);
      border-radius: 10px; padding: 12px 14px; width: 255px;
      backdrop-filter: blur(8px);
    }
    .day-time-row {
      display: flex; justify-content: space-between; align-items: center;
      font-size: 12px; color: var(--text-muted); margin-bottom: 6px; font-weight: 600;
    }
    .day-time-row strong { color: var(--gold); font-size: 13px; }
    .weather-badge {
      font-size: 11px; padding: 2px 7px; border-radius: 10px;
      background: rgba(255,255,255,0.08); color: var(--text-main);
    }
    .mission-box { border-top: 1px solid rgba(255,255,255,0.08); padding-top: 8px; margin-top: 4px; }
    .mission-title { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--accent); font-weight: 700; margin-bottom: 3px; }
    .mission-text { font-size: 12.5px; line-height: 1.35; color: var(--text-main); }

    .hud-top-right { position: absolute; top: 16px; right: 16px; display: flex; gap: 8px; pointer-events: auto; }
    .hud-btn {
      background: var(--panel-bg); border: 1px solid var(--panel-border); color: var(--text-main);
      padding: 7px 11px; border-radius: 7px; font-size: 12px; font-weight: 600;
      cursor: pointer; transition: all 0.15s ease; backdrop-filter: blur(6px);
    }
    .hud-btn:hover { border-color: var(--gold); color: var(--gold); }

    .hud-bottom-left {
      position: absolute; bottom: 18px; left: 16px; width: 230px;
      background: var(--panel-bg); border: 1px solid var(--panel-border);
      border-radius: 10px; padding: 10px 12px; backdrop-filter: blur(8px);
      display: flex; flex-direction: column; gap: 7px;
    }
    .vital-row { display: flex; align-items: center; gap: 8px; font-size: 11px; }
    .vital-icon { width: 18px; text-align: center; font-size: 13px; }
    .vital-bar-bg { flex: 1; height: 8px; background: rgba(255,255,255,0.1); border-radius: 4px; overflow: hidden; }
    .vital-bar-fill { height: 100%; border-radius: 4px; transition: width 0.2s ease; }
    .vital-val { width: 28px; text-align: right; font-weight: 600; font-size: 11px; color: var(--text-muted); }

    .hud-bottom-center {
      position: absolute; bottom: 18px; left: 50%; transform: translateX(-50%);
      display: flex; gap: 8px; pointer-events: auto;
    }
    .hotbar-slot {
      width: 58px; height: 58px; background: var(--panel-bg);
      border: 2px solid var(--panel-border); border-radius: 9px;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      position: relative; cursor: pointer; transition: all 0.15s ease; backdrop-filter: blur(6px);
    }
    .hotbar-slot.selected { border-color: var(--gold); box-shadow: 0 0 14px rgba(212,166,86,0.4); transform: translateY(-3px); }
    .hotbar-num { position: absolute; top: 3px; left: 5px; font-size: 10px; color: var(--text-muted); font-weight: 700; }
    .hotbar-emoji { font-size: 22px; line-height: 1; }
    .hotbar-label { font-size: 9.5px; color: var(--text-muted); margin-top: 3px; max-width: 52px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .hotbar-qty { position: absolute; bottom: 3px; right: 5px; font-size: 10px; font-weight: 700; color: var(--gold); }

    #build-bar {
      position: absolute; bottom: 90px; left: 50%; transform: translateX(-50%);
      background: var(--panel-bg); border: 1px solid var(--gold);
      border-radius: 10px; padding: 8px 12px; display: none; gap: 8px; align-items: center;
      pointer-events: auto; backdrop-filter: blur(8px);
    }
    .build-opt {
      padding: 6px 10px; border-radius: 6px; border: 1px solid var(--panel-border);
      background: rgba(255,255,255,0.04); cursor: pointer; font-size: 11px; text-align: center;
      transition: all 0.15s ease;
    }
    .build-opt.active { border-color: var(--gold); background: rgba(212,166,86,0.18); color: var(--gold); }
    .build-cost { font-size: 9.5px; color: var(--text-muted); margin-top: 2px; }

    .hud-top-center {
      position: absolute; top: 16px; left: 50%; transform: translateX(-50%);
      background: var(--panel-bg); border: 1px solid var(--panel-border);
      border-radius: 20px; padding: 5px 16px; font-size: 12px; font-weight: 600;
      letter-spacing: 0.6px; color: var(--text-main); backdrop-filter: blur(6px);
    }

    #toast-container {
      position: fixed; top: 70px; right: 16px; z-index: 30;
      display: flex; flex-direction: column; gap: 6px; pointer-events: none;
    }
    .toast {
      background: rgba(14, 20, 17, 0.94); border-left: 3px solid var(--gold);
      padding: 9px 14px; border-radius: 6px; font-size: 12.5px;
      box-shadow: 0 4px 14px rgba(0,0,0,0.55); animation: slideIn 0.25s ease;
      max-width: 280px;
    }
    @keyframes slideIn { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: translateX(0); } }

    #mobile-controls {
      position: fixed; bottom: 90px; left: 16px; right: 16px;
      display: none; justify-content: space-between; pointer-events: none; z-index: 12;
    }
    .touch-pad { display: grid; grid-template-columns: repeat(3, 44px); gap: 4px; pointer-events: auto; }
    .touch-btn {
      width: 44px; height: 44px; border-radius: 8px; background: rgba(15,20,18,0.7);
      border: 1px solid var(--panel-border); color: #fff; font-weight: 700; font-size: 14px;
      display: flex; align-items: center; justify-content: center; cursor: pointer;
    }
    .touch-actions { display: flex; gap: 8px; align-items: flex-end; pointer-events: auto; }

    .overlay-screen {
      position: fixed; inset: 0; z-index: 50; display: flex; align-items: center; justify-content: center;
      background: rgba(5, 8, 7, 0.78); backdrop-filter: blur(10px);
    }
    .hidden { display: none !important; }

    #main-menu {
      background: linear-gradient(110deg, rgba(5,8,7,0.92) 0%, rgba(8,12,10,0.62) 55%, rgba(5,8,7,0.86) 100%);
      justify-content: flex-start; padding-left: 8vw;
    }
    .menu-container { max-width: 470px; width: 90%; }
    .game-subtitle {
      font-size: 12px; letter-spacing: 4px; text-transform: uppercase;
      color: var(--accent); font-weight: 700; margin-bottom: 8px;
    }
    .game-title {
      font-family: 'Cinzel', serif; font-size: clamp(34px, 5vw, 56px);
      font-weight: 900; line-height: 1.05; letter-spacing: 2px;
      text-shadow: 0 4px 24px rgba(0,0,0,0.9); margin-bottom: 12px;
    }
    .game-tagline { font-size: 14px; color: var(--text-muted); line-height: 1.5; margin-bottom: 28px; }

    .menu-buttons { display: flex; flex-direction: column; gap: 10px; }
    .menu-btn {
      background: rgba(20, 27, 24, 0.85); border: 1px solid var(--panel-border);
      color: var(--text-main); padding: 13px 20px; border-radius: 8px;
      font-size: 15px; font-weight: 600; text-align: left; cursor: pointer;
      transition: all 0.18s ease; display: flex; justify-content: space-between; align-items: center;
    }
    .menu-btn:hover:not(:disabled) {
      border-color: var(--accent); background: rgba(200, 62, 43, 0.18);
      transform: translateX(6px); box-shadow: 0 4px 18px var(--accent-glow);
    }
    .menu-btn.primary { background: var(--accent); border-color: #e0523e; color: #fff; }
    .menu-btn.primary:hover { background: #d94632; }
    .menu-btn:disabled { opacity: 0.4; cursor: not-allowed; }

    .modal-card {
      background: var(--panel-bg); border: 1px solid var(--panel-border);
      border-radius: 14px; padding: 24px; max-width: 820px; width: 92%; max-height: 88vh;
      overflow-y: auto; box-shadow: 0 20px 50px rgba(0,0,0,0.85);
    }
    .modal-header {
      display: flex; justify-content: space-between; align-items: center;
      border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 12px; margin-bottom: 18px;
    }
    .modal-header h2 { font-family: 'Cinzel', serif; font-size: 22px; letter-spacing: 1px; color: var(--gold); }
    .close-btn {
      background: rgba(255,255,255,0.08); border: 1px solid var(--panel-border);
      color: var(--text-main); width: 32px; height: 32px; border-radius: 6px;
      cursor: pointer; font-size: 16px; font-weight: 700;
    }
    .close-btn:hover { background: var(--accent); border-color: var(--accent); }

    .inv-layout { display: grid; grid-template-columns: 1.2fr 1fr; gap: 20px; }
    @media (max-width: 700px) { .inv-layout { grid-template-columns: 1fr; } }

    .section-label { font-size: 11px; text-transform: uppercase; letter-spacing: 1.2px; color: var(--text-muted); margin-bottom: 8px; font-weight: 700; }

    .equip-slots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 16px; }
    .inv-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
    .inv-slot {
      aspect-ratio: 1; background: rgba(0,0,0,0.35); border: 1px solid var(--panel-border);
      border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center;
      position: relative; cursor: grab; transition: border-color 0.15s ease, background 0.15s ease;
      padding: 4px; text-align: center;
    }
    .inv-slot:hover { border-color: var(--gold); background: rgba(255,255,255,0.05); }
    .inv-slot.drag-over { border-color: var(--green); background: rgba(78,168,100,0.2); }
    .inv-slot .slot-tag { font-size: 9px; color: var(--text-muted); position: absolute; top: 3px; left: 5px; }
    .inv-slot .item-icon { font-size: 24px; }
    .inv-slot .item-name { font-size: 9.5px; color: var(--text-main); margin-top: 2px; line-height: 1.1; }
    .inv-slot .item-count { position: absolute; bottom: 3px; right: 5px; font-size: 11px; font-weight: 700; color: var(--gold); }

    .craft-list { display: flex; flex-direction: column; gap: 8px; max-height: 360px; overflow-y: auto; }
    .craft-item {
      background: rgba(0,0,0,0.3); border: 1px solid var(--panel-border);
      border-radius: 8px; padding: 10px 12px; display: flex; justify-content: space-between; align-items: center; gap: 10px;
    }
    .craft-info h4 { font-size: 13px; font-weight: 600; margin-bottom: 2px; }
    .craft-info p { font-size: 11px; color: var(--text-muted); }
    .craft-btn {
      background: var(--green); color: #08120a; border: none; padding: 7px 12px;
      border-radius: 6px; font-weight: 700; font-size: 12px; cursor: pointer;
    }
    .craft-btn:disabled { background: rgba(255,255,255,0.1); color: var(--text-muted); cursor: not-allowed; }

    .setting-row {
      display: flex; justify-content: space-between; align-items: center;
      padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .setting-row label { font-size: 14px; font-weight: 500; }
    .setting-row select, .setting-row input[type="range"] {
      background: #141c18; color: var(--text-main); border: 1px solid var(--panel-border);
      padding: 6px 10px; border-radius: 6px; font-size: 13px;
    }

    .note-paper {
      background: #e9dec4; color: #241c14; padding: 28px; border-radius: 6px;
      font-family: Georgia, serif; line-height: 1.65; box-shadow: inset 0 0 30px rgba(80,50,20,0.25);
    }
    .note-paper h3 { font-family: 'Cinzel', serif; font-size: 20px; margin-bottom: 12px; border-bottom: 1px solid #b5a384; padding-bottom: 6px; }

    #click-to-lock {
      position: fixed; bottom: 155px; left: 50%; transform: translateX(-50%);
      background: rgba(10,14,12,0.86); border: 1px solid var(--gold); color: var(--gold);
      padding: 7px 16px; border-radius: 20px; font-size: 12px; font-weight: 600;
      z-index: 15; display: none; cursor: pointer;
    }
  </style>
</head>
<body>
  <canvas id="game-canvas"></canvas>
  <div id="vignette"></div>
  <div id="damage-flash"></div>
  <div id="lightning-flash"></div>
  <div id="crosshair"></div>
  <div id="interact-prompt"></div>
  <div id="click-to-lock">Click anywhere on the world to lock mouse &amp; look around (or drag)</div>
  <div id="toast-container"></div>

  <!-- HUD -->
  <div id="hud">
    <div class="hud-top-left">
      <div class="day-time-row">
        <span>DAY <strong id="hud-day">1</strong> • <span id="hud-time">08:00</span></span>
        <span class="weather-badge" id="hud-weather">Clear</span>
      </div>
      <div class="mission-box">
        <div class="mission-title">Current Objective</div>
        <div class="mission-text" id="hud-mission">Inspect the airplane crash and gather wood &amp; stones.</div>
      </div>
    </div>

    <div class="hud-top-center" id="hud-zone">Dense Pine Forest</div>

    <div class="hud-top-right">
      <button class="hud-btn" id="btn-inv-open">🎒 Inventory [Tab]</button>
      <button class="hud-btn" id="btn-build-toggle">🔨 Build [B]</button>
      <button class="hud-btn" id="btn-pause-open">⏸ Pause [P]</button>
    </div>

    <div class="hud-bottom-left">
      <div class="vital-row">
        <span class="vital-icon">❤️</span>
        <div class="vital-bar-bg"><div class="vital-bar-fill" id="bar-hp" style="width:100%; background:#d63c3c;"></div></div>
        <span class="vital-val" id="val-hp">100</span>
      </div>
      <div class="vital-row">
        <span class="vital-icon">🍖</span>
        <div class="vital-bar-bg"><div class="vital-bar-fill" id="bar-hunger" style="width:100%; background:#d98a36;"></div></div>
        <span class="vital-val" id="val-hunger">100</span>
      </div>
      <div class="vital-row">
        <span class="vital-icon">💧</span>
        <div class="vital-bar-bg"><div class="vital-bar-fill" id="bar-thirst" style="width:100%; background:#3b8fc2;"></div></div>
        <span class="vital-val" id="val-thirst">100</span>
      </div>
      <div class="vital-row">
        <span class="vital-icon">⚡</span>
        <div class="vital-bar-bg"><div class="vital-bar-fill" id="bar-stamina" style="width:100%; background:#4ea864;"></div></div>
        <span class="vital-val" id="val-stamina">100</span>
      </div>
    </div>

    <div id="build-bar">
      <div class="build-opt active" data-build="campfire">🔥 Campfire<div class="build-cost">3 Wood, 3 Stone</div></div>
      <div class="build-opt" data-build="shelter">⛺ Shelter<div class="build-cost">8 Wood, 4 Leaf</div></div>
      <div class="build-opt" data-build="wall">🪵 Wall<div class="build-cost">4 Wood</div></div>
      <div class="build-opt" data-build="door">🚪 Door<div class="build-cost">4 Wood, 2 Stone</div></div>
      <div class="build-opt" data-build="fence">🚧 Fence<div class="build-cost">2 Wood, 2 Leaf</div></div>
      <div class="build-opt" data-build="trap">🪤 Spike Trap<div class="build-cost">3 Wood, 2 Stone</div></div>
      <span style="font-size:11px; color:var(--text-muted); margin-left:4px;">[R] Rotate • Click Place</span>
    </div>

    <div class="hud-bottom-center" id="hotbar"></div>
  </div>

  <!-- Mobile / Fallback Touch Controls -->
  <div id="mobile-controls">
    <div class="touch-pad">
      <div></div><button class="touch-btn" data-key="KeyW">W</button><div></div>
      <button class="touch-btn" data-key="KeyA">A</button><button class="touch-btn" data-key="KeyS">S</button><button class="touch-btn" data-key="KeyD">D</button>
    </div>
    <div class="touch-actions">
      <button class="touch-btn" id="touch-interact" style="width:auto;padding:0 12px;">Use [E]</button>
      <button class="touch-btn" id="touch-attack" style="width:auto;padding:0 12px;background:rgba(200,62,43,0.75);">Hit</button>
      <button class="touch-btn" id="touch-jump">↑</button>
    </div>
  </div>

  <!-- MAIN MENU -->
  <div id="main-menu" class="overlay-screen">
    <div class="menu-container">
      <div class="game-subtitle">Next-Gen 3D Survival Horror</div>
      <h1 class="game-title">FOREST:<br/>THE LAST SURVIVOR</h1>
      <p class="game-tagline">Flight 407 went down over an uncharted peninsula. Scavenge, build shelter, outsmart the forest's cannibals, and uncover what lies beneath the abandoned laboratory.</p>
      <div class="menu-buttons">
        <button class="menu-btn primary" id="btn-new-game"><span>▶ New Game</span><span>→</span></button>
        <button class="menu-btn" id="btn-continue" disabled><span>↻ Continue Saved Survival</span><span id="save-info">No Save</span></button>
        <button class="menu-btn" id="btn-settings"><span>⚙ Graphics &amp; Sound Settings</span><span>→</span></button>
        <button class="menu-btn" id="btn-controls"><span>🎮 Controls &amp; Survival Guide</span><span>→</span></button>
        <button class="menu-btn" id="btn-fullscreen"><span>⛶ Toggle Fullscreen</span><span></span></button>
      </div>
    </div>
  </div>

  <!-- SETTINGS MODAL -->
  <div id="settings-modal" class="overlay-screen hidden">
    <div class="modal-card" style="max-width: 520px;">
      <div class="modal-header">
        <h2>Settings</h2>
        <button class="close-btn" id="btn-close-settings">✕</button>
      </div>
      <div class="setting-row">
        <label for="opt-graphics">Graphics Quality</label>
        <select id="opt-graphics">
          <option value="low">Low (High FPS)</option>
          <option value="medium">Medium (Balanced)</option>
          <option value="high" selected>High (God Rays &amp; Dense Flora)</option>
          <option value="ultra">Ultra (4K Shadows &amp; Reflections)</option>
          <option value="extreme">EXTREME (Max Foliage &amp; Volumetrics)</option>
        </select>
      </div>
      <div class="setting-row">
        <label for="opt-sens">Mouse Sensitivity</label>
        <input type="range" id="opt-sens" min="0.4" max="2.5" step="0.1" value="1.0" />
      </div>
      <div class="setting-row">
        <label for="opt-master-vol">Master Volume</label>
        <input type="range" id="opt-master-vol" min="0" max="1" step="0.05" value="0.7" />
      </div>
      <div class="setting-row">
        <label for="opt-amb-vol">Ambience &amp; Horror Music</label>
        <input type="range" id="opt-amb-vol" min="0" max="1" step="0.05" value="0.6" />
      </div>
      <div class="setting-row">
        <label for="opt-mute">Mute All Audio</label>
        <input type="checkbox" id="opt-mute" style="width:18px;height:18px;cursor:pointer;" />
      </div>
      <div class="setting-row">
        <label for="opt-touch">Show On-Screen Touch Controls</label>
        <input type="checkbox" id="opt-touch" style="width:18px;height:18px;cursor:pointer;" />
      </div>
    </div>
  </div>

  <!-- CONTROLS GUIDE MODAL -->
  <div id="controls-modal" class="overlay-screen hidden">
    <div class="modal-card" style="max-width: 560px;">
      <div class="modal-header">
        <h2>Controls &amp; Survival Guide</h2>
        <button class="close-btn" id="btn-close-controls">✕</button>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; font-size:13px; line-height:1.6;">
