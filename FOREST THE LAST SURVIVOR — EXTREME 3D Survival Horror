    const theta = Math.random() * Math.PI * 2;
    const phi = Math.acos(Math.random() * 0.85 + 0.15);
    starVerts.push(220 * Math.sin(phi) * Math.cos(theta), 220 * Math.cos(phi), 220 * Math.sin(phi) * Math.sin(theta));
  }
  starGeo.setAttribute('position', new THREE.Float32BufferAttribute(starVerts, 3));
  const starMat = new THREE.PointsMaterial({ color: 0xe2e8f0, size: 0.9, transparent: true, opacity: 0 });
