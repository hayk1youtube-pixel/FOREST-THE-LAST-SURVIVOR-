  // =========================================================================
  // 4. PROCEDURAL PBR TEXTURES & NORMAL/BUMP MAPS
  // =========================================================================
  function makeProceduralTexture(size, drawFn, repeatX = 1, repeatY = 1) {
    const c = document.createElement('canvas');
    c.width = size; c.height = size;
    const ctx = c.getContext('2d');
    drawFn(ctx, size);
    const tex = new THREE.CanvasTexture(c);
    tex.wrapS = THREE.RepeatWrapping;
    tex.wrapT = THREE.RepeatWrapping;
    tex.repeat.set(repeatX, repeatY);
    return tex;
  }

  const barkTex = makeProceduralTexture(256, (ctx, s) => {
    ctx.fillStyle = '#3b2818';
    ctx.fillRect(0, 0, s, s);
    for (let i = 0; i < 420; i++) {
      ctx.fillStyle = i % 3 === 0 ? '#24170d' : (i % 5 === 0 ? '#2e3b21' : '#4d3521');
      ctx.fillRect(Math.random()*s, Math.random()*s, 2 + Math.random()*4, 18 + Math.random()*45);
    }
  }, 2, 4);

  const groundTex = makeProceduralTexture(512, (ctx, s) => {
    ctx.fillStyle = '#364d2b';
    ctx.fillRect(0, 0, s, s);
    for (let i = 0; i < 3800; i++) {
      const r = Math.random();
      ctx.fillStyle = r < 0.35 ? 'rgba(30,45,22,0.45)' : (r < 0.7 ? 'rgba(72,92,48,0.35)' : 'rgba(65,48,32,0.35)');
      ctx.fillRect(Math.random()*s, Math.random()*s, 3 + Math.random()*7, 3 + Math.random()*7);
    }
  }, 28, 28);

  const rockTex = makeProceduralTexture(256, (ctx, s) => {
    ctx.fillStyle = '#5a5f63';
    ctx.fillRect(0, 0, s, s);
