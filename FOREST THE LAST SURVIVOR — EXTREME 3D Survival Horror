  function createTree(x, z, scale = 1) {
    const y = getTerrainHeight(x, z);
    if (y < WATER_LEVEL + 0.35 || y > 11.5) return;
    const g = new THREE.Group();

    // Flared Roots
    for (let r = 0; r < 4; r++) {
      const ang = (r / 4) * Math.PI * 2 + Math.random() * 0.4;
      const root = new THREE.Mesh(new THREE.CylinderGeometry(0.1*scale, 0.22*scale, 1.3*scale, 5), barkMat);
      root.position.set(Math.cos(ang)*0.38*scale, 0.35*scale, Math.sin(ang)*0.38*scale);
      root.rotation.z = Math.cos(ang) * -0.55;
      root.rotation.x = Math.sin(ang) * 0.55;
      g.add(root);
    }

    const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.24*scale, 0.44*scale, 5.2*scale, 8), barkMat);
    trunk.position.y = 2.6 * scale;
    trunk.castShadow = true;
    trunk.receiveShadow = true;
    g.add(trunk);

    for (let i = 0; i < 4; i++) {
      const cone = new THREE.Mesh(new THREE.ConeGeometry((2.4 - i*0.42)*scale, 3.0*scale, 8), pineMat);
      cone.position.y = (3.8 + i*1.45) * scale;
      cone.rotation.y = Math.random() * Math.PI;
      cone.castShadow = true;
      cone.receiveShadow = true;
      g.add(cone);
    }
    g.position.set(x, y, z);
    scene.add(g);
    const col = { x, z, r: 0.58 * scale, obj: g, type: 'tree' };
    colliders.push(col);
    harvestables.push({ mesh: g, type: 'tree', hp: 3, maxHp: 3, x, z, collider: col, alive: true });
  }

