    document.getElementById('hud-weather').textContent = state.weather;

    document.getElementById('bar-hp').style.width = `${state.hp}%`;
    document.getElementById('val-hp').textContent = Math.ceil(state.hp);
    document.getElementById('bar-hunger').style.width = `${state.hunger}%`;
    document.getElementById('val-hunger').textContent = Math.ceil(state.hunger);
    document.getElementById('bar-thirst').style.width = `${state.thirst}%`;
    document.getElementById('val-thirst').textContent = Math.ceil(state.thirst);
    document.getElementById('bar-stamina').style.width = `${state.stamina}%`;
    document.getElementById('val-stamina').textContent = Math.ceil(state.stamina);

    let zone = 'Dense Pine Forest';
    if (Math.hypot(player.x, player.z + 8) < 16) zone = 'Flight 407 Crash Site';
    else if (Math.hypot(player.x + 48, player.z - 12) < 18) zone = 'Dark Underground Cave';
    else if (Math.hypot(player.x - 48, player.z + 42) < 18) zone = 'Abandoned Research Lab';
    else if (Math.hypot(player.x - 30, player.z - 35) < 25) zone = 'Clearwater Lake';
